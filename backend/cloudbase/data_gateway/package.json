{
  "name": "data_gateway",
  "version": "1.0.0",
  "description": "Family Garden · CloudBase 数据网关云函数(Godot HTTP CRUD 入口)",
  "main": "index.js",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
