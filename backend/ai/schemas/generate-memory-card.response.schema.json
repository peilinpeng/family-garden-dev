{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://family-garden.local/schemas/generate-memory-card.response.schema.json",
  "title": "generate-memory-card 响应",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "data", "meta"],
      "properties": {
        "ok": { "const": true },
        "data": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["title", "description", "memory_type", "suggested_scene", "question", "node_type", "confidence"],
              "properties": {
                "title": { "type": "string", "minLength": 1, "maxLength": 40 },
                "description": { "type": "string", "minLength": 1, "maxLength": 300 },
                "memory_type": { "$ref": "common.schema.json#/$defs/memoryType" },
                "suggested_scene": { "$ref": "common.schema.json#/$defs/scene" },
                "question": { "type": "string", "minLength": 1, "maxLength": 120 },
                "node_type": { "type": "string", "enum": ["memory_flower", "memory_seed", "photo_board", "postcard"] },
                "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
                "safety_note": { "type": "string", "maxLength": 200 },
                "guess": { "type": "string", "maxLength": 120 }
              }
            }
          ]
        },
        "meta": { "$ref": "common.schema.json#/$defs/successMeta" }
      },
      "allOf": [
        {
          "if": { "properties": { "data": { "type": "null" } } },
          "then": { "properties": { "meta": { "type": "object", "properties": { "result": { "const": "empty" } } } } },
          "else": { "properties": { "meta": { "type": "object", "properties": { "result": { "const": "complete" } } } } }
        }
      ]
    },
    { "$ref": "common.schema.json#/$defs/failureEnvelope" }
  ]
}
