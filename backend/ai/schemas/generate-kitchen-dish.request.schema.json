{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://family-garden.local/schemas/generate-kitchen-dish.request.schema.json",
  "title": "generate-kitchen-dish 请求",
  "type": "object",
  "additionalProperties": false,
  "required": ["dish_id", "station_type", "ingredients", "tone", "language"],
  "properties": {
    "dish_id": { "$ref": "common.schema.json#/$defs/id" },
    "station_type": { "type": "string", "enum": ["stove", "prep_table", "pantry"] },
    "ingredients": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "qty"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "name": { "type": "string", "minLength": 1, "maxLength": 40 },
          "qty": { "type": "integer", "minimum": 1, "maximum": 9 }
        }
      }
    },
    "tone": { "type": "string", "enum": ["warm"] },
    "language": { "$ref": "common.schema.json#/$defs/language" }
  }
}
