NODE_ENV=development
AI_PROVIDER=hunyuan
AUTH_MODE=gateway
SAFETY_MODE=tencent

# 现有 CloudBase data_gateway HTTP 地址，用 whoami 校验 member_token。
DATA_GATEWAY_URL=https://example.ap-shanghai.app.tcloudbase.com/data_gateway

# 腾讯云密钥只配置在云函数环境变量，禁止写入真实值。
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENTCLOUD_REGION=ap-shanghai

# 模型名称必须由部署环境显式提供，避免代码绑定会变化的模型。
HUNYUAN_TEXT_MODEL=
HUNYUAN_VISION_MODEL=

# 内容安全控制台中的策略编号；留空时使用账号默认策略。
TMS_BIZ_TYPE=
IMS_BIZ_TYPE=

AI_TIMEOUT_MS=20000
AI_MAX_RETRIES=1
AI_MAX_BODY_BYTES=32768
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX=20
AI_MAX_CONCURRENCY=8
AI_CIRCUIT_FAILURE_THRESHOLD=5
AI_CIRCUIT_RESET_MS=30000
AI_IDEMPOTENCY_TTL_MS=300000

# 仅本地开发可用；production 禁止关闭鉴权或使用 local 安全模式。
ALLOW_INSECURE_LOCAL=false
